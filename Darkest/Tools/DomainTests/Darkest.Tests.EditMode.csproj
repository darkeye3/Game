<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unity 없이 EditMode 테스트를 실행한다. Unity와 마찬가지로 도메인은 별도 어셈블리이므로
    internal 멤버를 테스트에서 쓰면 여기서도 컴파일 에러가 난다(Unity와 동일한 조건).
    사용법: dotnet test Tools/DomainTests
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Darkest/Tests/EditMode/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Domain/Darkest.Domain.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>
</Project>
